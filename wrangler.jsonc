// Cloudflare Workers deployment: an assets-only Worker serving the Vite build in dist/.
// `npm run build` must run first; CI deploys branch pushes as Previews and version tags to
// production (.github/workflows/ci.yml).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "singbox-confgen",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Single page: anything that isn't a file gets index.html.
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true,
  "preview_urls": true
}
