# Response headers for Cloudflare Workers static assets (copied into dist/ by Vite).
# The page's own CSP is a <meta> tag added at build time; frame-ancestors only works as a header.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
